# Supabase-project van Autofiscaliteit.
# Kopieer dit bestand naar .env.local en vul de waarden van je eigen project in
# (Supabase → Project Settings → API). Laat je ze leeg, dan valt de applicatie
# terug op het publieke project van Autofiscaliteit; wil je met je eigen
# database werken, dan zijn ze dus wél nodig.
#
# Maakte je het project via de Vercel-marketplace, dan staan de waarden daar al
# onder SUPABASE_URL en SUPABASE_ANON_KEY (of SUPABASE_PUBLISHABLE_KEY). Die
# namen worden ook herkend; je hoeft niets te dupliceren.
# Gebruik nooit een secret of service_role-sleutel: die belandt in de
# browserbundel en omzeilt alle RLS-policies. De build weigert dat.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-key>

# Optioneel. Basis-URL voor metadata; standaard https://autofiscaliteit.com
NEXT_PUBLIC_SITE_URL=

# Optioneel. Externe donatiepagina; laat leeg om de knop te verbergen.
NEXT_PUBLIC_DONATIE_URL=
